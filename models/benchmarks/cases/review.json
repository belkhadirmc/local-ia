{
    "id":  "review",
    "category":  "reasoning",
    "kind":  "static",
    "validation":  "static",
    "prompt":  "Review this Python code. List every bug or bad practice you find, one per line, each with a short fix. Be concise (maximum 200 words).\n\n```python\nimport sqlite3\n\nDB_PASSWORD = \"admin123\"\n\ndef get_user(conn, username):\n    cur = conn.cursor()\n    cur.execute(f\"SELECT * FROM users WHERE name = \u0027{username}\u0027\")\n    return cur.fetchone()\n\ndef read_lines(path):\n    f = open(path)\n    lines = f.readlines()\n    return lines\n\ndef average(values):\n    total = 0\n    for i in range(len(values) - 1):\n        total += values[i]\n    return total / len(values)\n\ndef parse_port(text):\n    try:\n        return int(text)\n    except:\n        pass\n```",
    "checks":  [
                   {
                       "name":  "sql_injection",
                       "type":  "regex",
                       "pattern":  "(?i)sql injection|injection|parameteri[sz]ed|placeholder"
                   },
                   {
                       "name":  "hardcoded_secret",
                       "type":  "regex",
                       "pattern":  "(?i)hard-?coded|DB_PASSWORD|plain ?text password|secret|credential"
                   },
                   {
                       "name":  "file_not_closed",
                       "type":  "regex",
                       "pattern":  "(?i)clos(e|ed|ing)|with open|context manager|leak"
                   },
                   {
                       "name":  "off_by_one",
                       "type":  "regex",
                       "pattern":  "(?i)off-by-one|off by one|range\\(len\\(values\\)\\)|last (element|item|value)|skips? the last"
                   },
                   {
                       "name":  "bare_except",
                       "type":  "regex",
                       "pattern":  "(?i)bare except|except:|swallow|silent|catch(es)?[- ]all|ValueError|returns? None"
                   },
                   {
                       "name":  "division_by_zero",
                       "type":  "regex",
                       "pattern":  "(?i)zero|empty (list|input|values)|ZeroDivision"
                   }
               ]
}
