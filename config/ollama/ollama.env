# Ollama - variables non sensibles (profil B, N1). Charge par compose/templates/ollama.yaml.
# Valeurs gerees par local-ai.ps1 profile apply (CONTEXT_LENGTH, KEEP_ALIVE, KV_CACHE_TYPE). 12.B.1 : microtests ADR-0012.
OLLAMA_HOST=0.0.0.0:11434
OLLAMA_NO_CLOUD=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MODELS=/models
OLLAMA_VULKAN=0
# Flash Attention : auto (active par Ollama, verifie dans les journaux) ; cache KV q8_0 = memoire KV / 2, vitesse inchangee.
OLLAMA_KV_CACHE_TYPE=q8_0
